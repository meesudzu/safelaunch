{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safelaunch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  "vars": { "WEB_ORIGIN": "https://safelaunch.runany.dev" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Durable Object: AbuseRateLimiter (B6).
  "durable_objects": {
    "bindings": [
      { "name": "ABUSE_RATE_LIMITER", "class_name": "AbuseRateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AbuseRateLimiter"] },
  ],
  "workflows": [
    {
      "name": "scan-workflow",
      "binding": "SCAN_WORKFLOW",
      "class_name": "ScanWorkflowEntrypoint",
    },
  ],

  // D1 production database.
  // Created via:  pnpm exec wrangler d1 create safelaunch
  // Migrations:    pnpm exec wrangler d1 migrations apply DB --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safelaunch",
      "database_id": "dc9e9e2d-fdf6-4da6-9f93-5d01744a868a",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],

  // R2 bucket: ARTIFACTS holds raw HTML snapshots captured during scans.
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "safelaunch-artifacts" },
  ],

  // Vectorize index: LEGAL_INDEX holds embeddings of approved vbpl.vn
  // provisions. Dimensions MUST match the embedding model — currently
  // @cf/baai/bge-base-en-v1.5 → 768 dimensions.
  "vectorize": [
    { "binding": "LEGAL_INDEX", "index_name": "safelaunch-legal" },
  ],

  "ai": { "binding": "AI" },

  // Queue: LEGAL_INGESTION_QUEUE receives vbpl.docx URLs from the
  // crawler; a consumer parses them into legal_provisions rows.
  "queues": {
    "producers": [
      { "binding": "LEGAL_INGESTION_QUEUE", "queue": "safelaunch-legal-ingestion" },
    ],
    // The API Worker also owns the queue consumer. Without this declaration,
    // messages can be produced successfully but are never delivered to the
    // Worker (the queue only shows a Producer in the dashboard).
    "consumers": [
      {
        "queue": "safelaunch-legal-ingestion",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
      },
    ],
  },
}
